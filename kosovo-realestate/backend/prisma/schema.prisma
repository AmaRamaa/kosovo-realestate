generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  AGENT
  ADMIN
}

enum ListingStatus {
  PENDING
  ACTIVE
  SOLD
  RENTED
  INACTIVE
  REJECTED
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  LAND
  COMMERCIAL
  OFFICE
  WAREHOUSE
  STUDIO
  DUPLEX
}

enum HeatingType {
  CENTRAL
  ELECTRIC
  GAS
  OIL
  WOOD
  HEAT_PUMP
  UNDERFLOOR
  NONE
}

enum EnergyRating {
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MessageStatus {
  SENT
  READ
  ARCHIVED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?
  firstName       String
  lastName        String
  phone           String?
  avatar          String?
  role            Role      @default(BUYER)
  isVerified      Boolean   @default(false)
  isActive        Boolean   @default(true)
  googleId        String?   @unique
  refreshToken    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agent           Agent?
  listings        Listing[]
  favorites       Favorite[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  appointments    Appointment[] @relation("BuyerAppointments")
  reviews         Review[]
  notifications   Notification[]
  savedSearches   SavedSearch[]
  recentViews     RecentView[]
  reports         Report[]

  @@map("users")
}

model Agent {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId        String?
  agency          Agency?   @relation(fields: [agencyId], references: [id])
  bio             String?
  licenseNumber   String?
  yearsExperience Int       @default(0)
  specializations String[]
  languages       String[]
  rating          Float     @default(0)
  reviewCount     Int       @default(0)
  listingCount    Int       @default(0)
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  listings        Listing[]
  appointments    Appointment[]
  reviews         Review[]

  @@map("agents")
}

model Agency {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  logo            String?
  coverImage      String?
  website         String?
  email           String
  phone           String
  address         String?
  cityId          String
  city            City      @relation(fields: [cityId], references: [id])
  rating          Float     @default(0)
  reviewCount     Int       @default(0)
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agents          Agent[]
  listings        Listing[]
  reviews         Review[]

  @@map("agencies")
}

model City {
  id              String    @id @default(cuid())
  name            String    @unique
  nameAlbanian    String?
  nameSerbian     String?
  slug            String    @unique
  description     String?
  image           String?
  lat             Float?
  lng             Float?
  isActive        Boolean   @default(true)
  listingCount    Int       @default(0)
  createdAt       DateTime  @default(now())

  neighborhoods   Neighborhood[]
  listings        Listing[]
  agencies        Agency[]

  @@map("cities")
}

model Neighborhood {
  id              String    @id @default(cuid())
  name            String
  cityId          String
  city            City      @relation(fields: [cityId], references: [id])
  slug            String
  lat             Float?
  lng             Float?
  createdAt       DateTime  @default(now())

  listings        Listing[]

  @@unique([cityId, slug])
  @@map("neighborhoods")
}

model Listing {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String
  listingType     ListingType
  propertyType    PropertyType
  status          ListingStatus @default(PENDING)

  price           Float
  priceNegotiable Boolean       @default(false)
  currency        String        @default("EUR")

  area            Float
  bedrooms        Int?
  bathrooms       Int?
  floor           Int?
  totalFloors     Int?
  yearBuilt       Int?
  parkingSpaces   Int           @default(0)
  garageSpaces    Int           @default(0)

  hasGarden       Boolean       @default(false)
  hasPool         Boolean       @default(false)
  hasBalcony      Boolean       @default(false)
  hasTerrace      Boolean       @default(false)
  hasElevator     Boolean       @default(false)
  hasSecurity     Boolean       @default(false)
  hasAirCon       Boolean       @default(false)
  hasHeating      Boolean       @default(false)
  hasFurnished    Boolean       @default(false)
  hasStorage      Boolean       @default(false)

  heatingType     HeatingType?
  energyRating    EnergyRating?

  address         String
  cityId          String
  city            City          @relation(fields: [cityId], references: [id])
  neighborhoodId  String?
  neighborhood    Neighborhood? @relation(fields: [neighborhoodId], references: [id])
  lat             Float?
  lng             Float?

  userId          String
  user            User          @relation(fields: [userId], references: [id])
  agentId         String?
  agent           Agent?        @relation(fields: [agentId], references: [id])
  agencyId        String?
  agency          Agency?       @relation(fields: [agencyId], references: [id])

  viewCount       Int           @default(0)
  favoriteCount   Int           @default(0)
  isFeatured      Boolean       @default(false)
  featuredUntil   DateTime?

  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  images          ListingImage[]
  amenities       ListingAmenity[]
  favorites       Favorite[]
  appointments    Appointment[]
  reviews         Review[]
  recentViews     RecentView[]
  reports         Report[]

  @@map("listings")
}

model ListingImage {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url         String
  publicId    String?
  alt         String?
  order       Int       @default(0)
  isCover     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("listing_images")
}

model Amenity {
  id          String    @id @default(cuid())
  name        String    @unique
  icon        String?
  category    String?
  createdAt   DateTime  @default(now())

  listings    ListingAmenity[]

  @@map("amenities")
}

model ListingAmenity {
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenityId   String
  amenity     Amenity   @relation(fields: [amenityId], references: [id])

  @@id([listingId, amenityId])
  @@map("listing_amenities")
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, listingId])
  @@map("favorites")
}

model Message {
  id          String        @id @default(cuid())
  senderId    String
  sender      User          @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User          @relation("ReceivedMessages", fields: [receiverId], references: [id])
  subject     String?
  content     String
  status      MessageStatus @default(SENT)
  listingId   String?
  parentId    String?
  parent      Message?      @relation("MessageReplies", fields: [parentId], references: [id])
  replies     Message[]     @relation("MessageReplies")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("messages")
}

model Appointment {
  id          String              @id @default(cuid())
  listingId   String
  listing     Listing             @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User                @relation("BuyerAppointments", fields: [buyerId], references: [id])
  agentId     String
  agent       Agent               @relation(fields: [agentId], references: [id])
  scheduledAt DateTime
  duration    Int                 @default(60)
  status      AppointmentStatus   @default(PENDING)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("appointments")
}

model Review {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  agentId     String?
  agent       Agent?    @relation(fields: [agentId], references: [id])
  agencyId    String?
  agency      Agency?   @relation(fields: [agencyId], references: [id])
  listingId   String?
  listing     Listing?  @relation(fields: [listingId], references: [id])
  rating      Int
  comment     String?
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("reviews")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  type        String
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  @@map("notifications")
}

model SavedSearch {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  filters     Json
  alertsEnabled Boolean @default(false)
  createdAt   DateTime  @default(now())

  @@map("saved_searches")
}

model RecentView {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewedAt    DateTime  @default(now())

  @@unique([userId, listingId])
  @@map("recent_views")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String
  tags        String[]
  authorName  String
  authorImage String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model Report {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id])
  reason      String
  description String?
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("reports")
}

model AuditLog {
  id          String    @id @default(cuid())
  userId      String?
  action      String
  resource    String
  resourceId  String?
  details     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}
